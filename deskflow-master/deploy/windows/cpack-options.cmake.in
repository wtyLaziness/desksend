if(CPACK_GENERATOR MATCHES 7Z|ZIP)
  set(CPACK_PACKAGE_FILE_NAME ${CPACK_PACKAGE_FILE_NAME}-portable)
elseif(CPACK_GENERATOR STREQUAL "WIX")
  if ("@DESKSEND_LOCALSEND_CLI@" STREQUAL "")
    message(FATAL_ERROR "The DeskSend MSI requires DESKSEND_LOCALSEND_CLI")
  endif()
  set(CPACK_PACKAGE_FILE_NAME "DeskSend-@DESKSEND_VERSION@-windows-@BUILD_ARCHITECTURE@")
endif()
